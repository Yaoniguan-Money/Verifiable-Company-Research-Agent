# Application
APP_NAME=Verifiable Company Research Agent
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/dev.db
DB_ECHO=false
USE_ALEMBIC_ON_STARTUP=false
REDIS_URL=
SEARCH_CACHE_TTL_SECONDS=86400

# Provider selection
# Search defaults to online public sources. CNINFO is used without a vendor API key;
# Baidu AI Search is added only when BAIDU_AI_SEARCH_API_KEY is configured.
# LLM stays mock by default to avoid surprise external API cost. Set
# LLM_PROVIDER=deepseek or LLM_PROVIDER=qianfan explicitly for real LLM generation.
LLM_PROVIDER=mock
SEARCH_PROVIDER=public_sources
EMBEDDING_PROVIDER=local_hashing
VECTOR_STORE=in_memory
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_RETRIEVAL_LLM_REWRITE=false
HYBRID_DENSE_TOP_K=50
HYBRID_SPARSE_TOP_K=50
HYBRID_FUSION_TOP_K=30
RERANKER_BACKEND=embedding
NLP_USE_ONNX=false
LLM_STREAMING_ENABLED=true
LANGFUSE_ENABLED=false
WORKFLOW_ENGINE=langgraph

# DeepSeek LLM
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_API_KEY=

# Search provider options
BAIDU_AI_SEARCH_ENDPOINT=
BAIDU_AI_SEARCH_MODEL=
BAIDU_AI_SEARCH_API_KEY=
BAIDU_AI_SEARCH_TOP_K=3
BAIDU_AI_SEARCH_TIMEOUT_SECONDS=30
BAIDU_AI_SEARCH_ENABLE_DEEP_SEARCH=false
BAIDU_AI_SEARCH_FETCH_REFERENCE_PAGES=true

# Qianfan LLM
QIANFAN_BASE_URL=
QIANFAN_MODEL=
QIANFAN_TIMEOUT_SECONDS=30
QIANFAN_API_KEY=

# Embedding provider options
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_BATCH_SIZE=10

# Search, vector, and workflow tuning
LOCAL_DOCUMENTS_DIR=./data/imports
OFFICIAL_URL_ALLOWED_DOMAINS=
OFFICIAL_URL_TIMEOUT_SECONDS=15
CNINFO_TIMEOUT_SECONDS=30
CNINFO_TOP_K=4
CNINFO_LOOKBACK_YEARS=4
CNINFO_MAX_SOURCE_CHARS=120000
MOCK_EMBEDDING_DIMENSION=8
LOCAL_EMBEDDING_DIMENSION=128
VECTOR_STORE_SQLITE_PATH=./data/vector_store.sqlite
WORKFLOW_CHUNK_SIZE=1600
WORKFLOW_CHUNK_OVERLAP=300
RETRIEVAL_TOP_K=15
RETRIEVAL_TOP_K_MIN=5
RETRIEVAL_TOP_K_RATIO=0.125
RETRIEVAL_METRICS_ENABLED=true
COMPLIANCE_STRICT_MODE=true
COMPLIANCE_BLOCK_ON_VIOLATION=true

# Chunking strategy: section_aware | recursive | fixed_window
CHUNKING_STRATEGY=section_aware
SECTION_MIN_CHUNK_SIZE=400

# Content enrichment & PDF caching
CONTENT_ENRICHMENT_ENABLED=true
PDF_CACHE_ENABLED=true
PDF_CACHE_DIR=./data/pdf_cache
PDF_CACHE_MAX_SIZE_MB=500
PDF_CACHE_TTL_HOURS=72
REPORT_PARSER_MAX_SECTIONS=12
TABLE_EXTRACTION_MAX_TABLES=12

# Content prioritization: intent_driven | llm_driven | none
CONTENT_PRIORITIZER=intent_driven
CONTENT_MAX_CHARS=120000
CONTENT_MIN_SECTION_CHARS=500
CONTENT_PRIORITIZER_LLM_ENABLED=false

# Evidence grounding
GROUNDING_SNIPPET_MAX_CHARS=300

# BM25 cache
BM25_CACHE_MAX_SIZE=16

# Vector store dimension validation: strict | warn | ignore
VECTOR_STORE_DIMENSION_VALIDATION=warn
