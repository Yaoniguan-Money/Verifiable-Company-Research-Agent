# Application
APP_NAME=Verifiable Company Research Agent
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/dev.db
DB_ECHO=false

# Provider selection
# Search defaults to online public sources. CNINFO is used without a vendor API key;
# Baidu AI Search is added only when BAIDU_AI_SEARCH_API_KEY is configured.
# LLM stays mock by default to avoid surprise external API cost. Set
# LLM_PROVIDER=deepseek or LLM_PROVIDER=qianfan explicitly for real LLM generation.
LLM_PROVIDER=mock
SEARCH_PROVIDER=public_sources
EMBEDDING_PROVIDER=local_hashing
VECTOR_STORE=in_memory
WORKFLOW_ENGINE=langgraph

# DeepSeek LLM
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_API_KEY=

# Search provider options
BAIDU_AI_SEARCH_ENDPOINT=
BAIDU_AI_SEARCH_MODEL=
BAIDU_AI_SEARCH_API_KEY=
BAIDU_AI_SEARCH_TOP_K=3
BAIDU_AI_SEARCH_TIMEOUT_SECONDS=30
BAIDU_AI_SEARCH_ENABLE_DEEP_SEARCH=false
BAIDU_AI_SEARCH_FETCH_REFERENCE_PAGES=true

# Qianfan LLM
QIANFAN_BASE_URL=
QIANFAN_MODEL=
QIANFAN_TIMEOUT_SECONDS=30
QIANFAN_API_KEY=

# Embedding provider options
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_BATCH_SIZE=10

# Search, vector, and workflow tuning
LOCAL_DOCUMENTS_DIR=./data/imports
OFFICIAL_URL_ALLOWED_DOMAINS=
OFFICIAL_URL_TIMEOUT_SECONDS=15
CNINFO_TIMEOUT_SECONDS=30
CNINFO_TOP_K=4
CNINFO_LOOKBACK_YEARS=4
CNINFO_MAX_SOURCE_CHARS=80000
MOCK_EMBEDDING_DIMENSION=8
LOCAL_EMBEDDING_DIMENSION=128
VECTOR_STORE_SQLITE_PATH=./data/vector_store.sqlite
WORKFLOW_CHUNK_SIZE=1600
WORKFLOW_CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5
COMPLIANCE_STRICT_MODE=true
COMPLIANCE_BLOCK_ON_VIOLATION=true
