# 可选 provider 示例，不代表架构限制。
# 使用方法：
# 1) 先复制 .env.example 为 .env
# 2) 再从本文件挑选所需 provider 配置写入 .env
# 3) 所有 API key 必须由本地手动填写，不要提交到仓库

# =========================
# LLM provider 示例
# =========================

# DeepSeek
# LLM_PROVIDER=deepseek
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=30
# DEEPSEEK_API_KEY=

# Qianfan
# LLM_PROVIDER=qianfan
# QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
# QIANFAN_MODEL=ernie-4.5-8k-preview
# QIANFAN_TIMEOUT_SECONDS=30
# QIANFAN_API_KEY=

# =========================
# Search provider 示例
# =========================

# Baidu AI Search
# SEARCH_PROVIDER=baidu_ai_search
# BAIDU_AI_SEARCH_ENDPOINT=https://qianfan.baidubce.com/v2/ai_search/chat/completions
# BAIDU_AI_SEARCH_MODEL=ernie-4.5-turbo-32k
# # 替换为你账号已开通的 chat model；其他常见值：ernie-4.5-turbo-128k、deepseek-v3、deepseek-r1。
# # 如果后端日志看到 Baidu AI Search business error: invalid_model - The model does not exist or you do not have access to it.，
# # 说明当前账号未开通该 model；请到百度千帆控制台 → 模型广场查可用 model 列表，或换一个已开通的 model。
# BAIDU_AI_SEARCH_API_KEY=
# BAIDU_AI_SEARCH_TOP_K=3
# BAIDU_AI_SEARCH_TIMEOUT_SECONDS=30
# BAIDU_AI_SEARCH_ENABLE_DEEP_SEARCH=false
# BAIDU_AI_SEARCH_FETCH_REFERENCE_PAGES=true

# Cninfo announcements
# SEARCH_PROVIDER=cninfo_announcements
# CNINFO_TIMEOUT_SECONDS=30
# CNINFO_TOP_K=6
# CNINFO_LOOKBACK_YEARS=4
# CNINFO_MAX_SOURCE_CHARS=300000

# Hybrid public sources（巨潮 + 可选百度搜索）
# SEARCH_PROVIDER=public_sources
# BAIDU_AI_SEARCH_API_KEY=

# =========================
# Embedding provider 示例
# =========================

# DashScope（OpenAI-compatible）
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSION=
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_MAX_BATCH_SIZE=10

# SiliconFlow（OpenAI-compatible）
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# EMBEDDING_DIMENSION=
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_MAX_BATCH_SIZE=10

# =========================
# 其他可选项
# =========================

# VECTOR_STORE=sqlite
# VECTOR_STORE_SQLITE_PATH=./data/vector_store.sqlite
# WORKFLOW_ENGINE=langgraph
